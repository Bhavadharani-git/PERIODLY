# Copy this file to .env and replace both values with unique secrets.
# Generate them with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_HEX_SECRET
PERIODLY_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Leave empty for same-origin frontend served by the API container.
# For a separately hosted frontend, provide exact HTTPS origins separated by commas.
CORS_ORIGINS=
